<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Depth is optional: unsupported devices keep the CameraX safety pipeline. -->
    <uses-feature android:name="com.google.ar.core.depth" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="Sesli Rehber"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- ARCore remains optional; no install prompt is forced for basic guidance. -->
        <meta-data android:name="com.google.ar.core" android:value="optional" />
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
